# foul-play — example environment for ONE gen9randombattle ladder game
# on the official Pokemon Showdown server.
#
# IMPORTANT: foul-play itself reads NO configuration from the environment.
# config.py (_FoulPlayConfig.configure) parses argparse CLI flags only.
# These variables exist so a launcher can build the command line; see the
# "EXACT RUN COMMAND" block at the bottom of this file.
#
# Usage:
#   cp .env.example .env      # then edit .env with real values
#   set -a; . ./.env; set +a  # export everything
#
# NEVER commit a filled-in .env — it contains your Showdown password.

# ---------------------------------------------------------------- runtime ---
# Python 3.11+ required. This venv is uv-provisioned CPython 3.12.13.
# The system python (3.9) is too old and must not be used.
FP_PYTHON=/Users/sallyliu/pokemon-fast-bot/foul-play/.venv/bin/python
FP_REPO=/Users/sallyliu/pokemon-fast-bot/foul-play

# Matches the Dockerfile; avoids UnicodeEncodeError on Pokemon names.
PYTHONIOENCODING=utf-8

# ------------------------------------------------------------ credentials ---
# A REGISTERED Showdown account is required to ladder. Never store real
# credentials in this example file.
PS_USERNAME=CHANGEME
PS_PASSWORD=CHANGEME

# ---------------------------------------------------------------- server ----
# Official Showdown simulator websocket.
FP_WEBSOCKET_URI=wss://sim3.psim.us/showdown/websocket

# --------------------------------------------------------------- battle -----
# search_ladder = queue for a ranked ladder game (vs challenge_user / accept_challenge).
FP_BOT_MODE=search_ladder
FP_POKEMON_FORMAT=gen9randombattle

# Exactly one battle, then exit.
FP_RUN_COUNT=1

# -------------------------------------------------------------- search ------
# NOT the wall budget -- the wall budget per later turn is this x2, because the
# random-battle path uses num_battles_multiplier=2 once past the opening. So
# 2250 => 4.5s TOTAL wall per turn. Worlds = parallelism x multiplier = 16, run
# as ceil(16/pool)=2 waves of 8, so the 4.5s splits into 2250ms per world.
# Under time pressure (<=60s left) the multiplier halves to 1 automatically:
# 8 worlds, 1 wave, 2.25s wall. base_search_time_ms also clamps to
# (time_remaining - 3s), so the clock cannot be run to zero.
FP_SEARCH_TIME_MS=2250

# Turn 1 IS the wall budget directly (not doubled). Turn 1 uses multiplier 4, so
# 8x4 = 32 worlds in 4 waves of 8 => 2500ms per world over a 10.0s wall. More,
# shallower worlds is deliberate: turn 1 has the least revealed information, so
# breadth over the hidden-info distribution beats depth in any single world.
FP_FIRST_TURN_SEARCH_TIME_MS=10000

# parallelism = the wave width; worlds searched = parallelism x multiplier.
# 8 spills onto this machine's E-cores (8 logical / 4 performance), which gets
# MORE total compute per wall-second than 4 P-cores alone but WILL make the
# laptop sluggish while a game is running. Drop to 4 to stay P-core-only
# (halves the world count; per-world ms is unchanged since waves halve too).
FP_SEARCH_PARALLELISM=8
FP_SEARCH_THREADS=1

# ------------------------------------------------------------- evaluator ----
# Path to the neural-net weights. Passing this switches leaf evaluation from the
# hand eval to the net. It is the ONLY flag the net bot needs: reward form
# (relative), tau (2.5 via NN_SCALE=145.3488), both UCB exploration factors
# (0.1/0.1) and FPU (+inf) are all engine DEFAULTS as of 2026-08-04, so there is
# no env-plumbing risk for them. run.py refuses to start if this file is missing
# and logs the engine's OWN effective config at startup, so a session's logs
# prove which evaluator and constants it actually ran with.
FP_NN_WEIGHTS=/Users/sallyliu/pokemon-fast-bot/valuenet/m4_artifacts/valuenet_weights.bin

# --------------------------------------------------------------- selection --
# 1 = pick the pooled visit-share argmax and BYPASS every selection gate
# (switch damping, variance penalty, opponent switch veto, pooled-share floors,
# score-band and displacement tiebreaks, losing-position fallback).
# Why on for the net bot: every Elo measurement behind the current config came
# from the duel harness, which reads the raw MCTS arm and never calls
# selection.py — so argmax is the policy we actually validated. The gates'
# thresholds were also sized for the hand eval's ~0.28 arm-value spread and are
# unverified under the net. Pass --selection-argmax-only to enable (flag, no value).
FP_SELECTION_ARGMAX_ONLY=1

# ---------------------------------------------------------------- logging ---
FP_LOG_LEVEL=INFO
# Pass --log-to-file to also write DEBUG logs under ./logs/ (flag, no value).
FP_LOG_TO_FILE=0

# Replay saving: always | never | on_loss | on_win
FP_SAVE_REPLAY=always

# ------------------------------------------------------------- not needed ---
# Random-battle formats need no team file, so --team-name / --team-list are
# unused here (FoulPlayConfig.requires_team() is False when the format string
# contains "random").
#
# The FP_CONTROL_* / FP_MEMBERSHIP_REPLAY environment variables that appear in
# fp/battle.py, fp/battle_modifier.py and fp/replay/checker.py are NEGATIVE
# CONTROLS for tests. Leave every one of them unset for a real ladder game.

# ------------------------------------------------------- EXACT RUN COMMAND ---
# cd "$FP_REPO" && "$FP_PYTHON" run.py \
#   --websocket-uri "$FP_WEBSOCKET_URI" \
#   --ps-username "$PS_USERNAME" \
#   --ps-password "$PS_PASSWORD" \
#   --bot-mode "$FP_BOT_MODE" \
#   --pokemon-format "$FP_POKEMON_FORMAT" \
#   --run-count "$FP_RUN_COUNT" \
#   --search-time-ms "$FP_SEARCH_TIME_MS" \
#   --first-turn-search-time-ms "$FP_FIRST_TURN_SEARCH_TIME_MS" \
#   --search-parallelism "$FP_SEARCH_PARALLELISM" \
#   --search-threads "$FP_SEARCH_THREADS" \
#   --nn-weights "$FP_NN_WEIGHTS" \
#   --selection-argmax-only \
#   --save-replay "$FP_SAVE_REPLAY" \
#   --log-level "$FP_LOG_LEVEL"
